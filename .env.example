# Copy to .env and edit. .env is git-ignored, so every teammate keeps their own.
# Relative paths are resolved against the project root. Real environment variables override this file.

# ---- Colab (shared Google Drive) -------------------------------------------------------------
# Everyone points at the SAME shared folder, so preprocessed data and checkpoints are shared and
# survive Colab timeouts. The shared folder must be added to "My Drive" as a shortcut
# (Drive > Shared with me > right-click "Biomedical Data Design" > Organize > Add shortcut).
NNUNET_ROOT="/content/drive/MyDrive/Biomedical Data Design/nnunet"
RAW_DATA_DIR="/content/drive/MyDrive/Biomedical Data Design/SegRap2023_Training_Set_120cases"

# ---- Local development (toy data) ------------------------------------------------------------
# NNUNET_ROOT=data/nnunet
# RAW_DATA_DIR=data/toy_raw

# ---- Optional overrides ----------------------------------------------------------------------
# Default: $NNUNET_ROOT/nnUNet_raw, $NNUNET_ROOT/nnUNet_preprocessed, $NNUNET_ROOT/nnUNet_results
# nnUNet_raw=
# nnUNet_preprocessed=
# nnUNet_results=
# Defaults for train.py / evaluate.py
# NNUNET_TRAINER=nnUNetTrainer
# NNUNET_PLANS=nnUNetPlans
# NNUNET_CONFIG=3d_fullres
